# PawFinder Backend Configuration

PROJECT_NAME=PawFinder
API_V1_STR=/api
ENVIRONMENT=development

# Database Configuration
# Default local SQLite fallback for dev/testing, or Supabase PostgreSQL connection string:
# postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=sqlite:///./pawfinder.db
TEST_DATABASE_URL=sqlite:///:memory:

# JWT Security
JWT_SECRET_KEY=pawfinder-super-secret-development-key-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Storage Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=pet-images

# Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

